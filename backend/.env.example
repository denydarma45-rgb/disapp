# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=ganti-dengan-secret-yang-sangat-panjang-dan-acak-min-32-karakter
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://127.0.0.1:5500

# WebRTC (opsional — ganti dengan Twilio/Janus credentials di production)
WEBRTC_PROVIDER=janus
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
